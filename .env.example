# Copy to .env and edit. .env is git-ignored; never commit real values here.
#
# Consumed by infra/docker-compose.yml (run via `make dev`, which passes
# --project-directory . so this file is found from the repo root). Every
# variable has a working default in the compose file itself -- an empty
# .env still brings up a healthy stack on the simulator gateway, no
# credentials required (ARCHITECTURE §9). This file exists so those
# defaults are visible and overridable in one place (ENGINEERING-STANDARDS
# §6: .env.example must be complete and current).

# --- Application -------------------------------------------------------

# development | test | production. Anything else fails Settings validation
# at startup (TR-75) -- that is deliberate, not a bug to work around.
ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- Postgres ------------------------------------------------------------
# Read by both the postgres container itself and DATABASE_URL, assembled
# from these in docker-compose.yml -- change them here, not in two places.

POSTGRES_USER=recoup
POSTGRES_PASSWORD=recoup
POSTGRES_DB=recoup
POSTGRES_PORT=5432

# --- Redis -----------------------------------------------------------------

REDIS_PORT=6379

# --- Anthropic Claude ----------------------------------------------------
# Unset by default. Only diagnosis hypothesis ranking (ARCHITECTURE §4,
# stage 3) calls this, and only when set -- everything else, including the
# rest of the pipeline, runs identically without it (AI-DESIGN).

ANTHROPIC_API_KEY=

# --- Razorpay --------------------------------------------------------------
# Unset by default -- the seeded simulator is the gateway with no
# credentials at all (ARCHITECTURE §8). Setting all three switches the
# gateway adapter to live Razorpay test mode; TEST-MODE KEYS ONLY
# (rzp_test_ prefix enforced at startup, TR-49). Never a live key, even in
# a local .env.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Ports exposed on the host ---------------------------------------------

API_PORT=8000
CONSOLE_PORT=3000
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090

# --- Console (browser-side) --------------------------------------------
# Baked in at container start, read by the browser -- see
# apps/console/.env.example for the plain `pnpm dev` (non-Docker) case.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
