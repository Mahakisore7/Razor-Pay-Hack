# The npm registry's bulk advisories endpoint (hit by `pnpm audit`) is
# occasionally slow to respond from CI runners. pnpm's defaults (2 retries,
# 10s/60s backoff) weren't enough to ride out a blip and failed the
# Security job on a registry timeout rather than a real finding -- widen
# the retry budget rather than weakening the gate.
fetch-retries=5
fetch-retry-mintimeout=15000
fetch-retry-maxtimeout=120000
network-timeout=120000
